---
interface Props { marginTop?: string; }
const { marginTop = "mt-12" } = Astro.props;
---
  <footer class:list={[marginTop, "mb-8 text-center text-xs text-gray-700 relative z-10"]}>
    <!-- bg-white/90 statt bg-white/60 für besseren Kontrast; text-gray-600/700 statt hellgrau -->
    <div class="max-w-md mx-auto px-5 py-3 bg-white/90 backdrop-blur-md rounded-xl border border-gray-200/80 shadow-md inline-flex items-center space-x-4">
      <span class="text-gray-500 font-normal">© 2026 Dönerrat Marburg</span>
      <span class="text-gray-300">|</span>
      <a href="impressum.html" class="text-gray-800 hover:text-blue-600 transition-colors font-semibold underline decoration-gray-300 hover:decoration-blue-500">Impressum</a>
      <span class="text-gray-300">|</span>
      <a href="datenschutz.html" class="text-gray-800 hover:text-blue-600 transition-colors font-semibold underline decoration-gray-300 hover:decoration-blue-500">Datenschutz</a>
    </div>
  </footer>
